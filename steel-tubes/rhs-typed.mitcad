    "rows": [
      {
        "name": "60x40x3",
        "values": {
          "H": "40 mm",
          "T": "3 mm",
          "W": "60 mm"
        }
      },
      {
        "name": "100x50x4",
        "values": {
          "H": "50 mm",
          "T": "4 mm",
          "W": "100 mm"
        }
      },
      {
        "name": "101.6x50.8x4.8",
        "values": {
          "H": "50.8 mm",
          "T": "4.8 mm",
          "W": "101.6 mm"
        }
      },
      {
        "name": "200x100x8",
        "values": {
          "H": "100 mm",
          "T": "8 mm",
          "W": "200 mm"
        }
      }
    ],
    "rules": [
      {
        "name": "Wall under a third of the side",
        "then": [
          {
            "require": "T < min(W; H) / 3",
            "message": "the wall T is a third of the smaller side or more"
          }
        ]
      },
      {
        "name": "Corners fit the side",
        "then": [
          {
            "require": "and(RO < min(W; H) / 2; RI < min(W; H) / 2 - T)",
            "message": "the corner radii for this wall do not fit the smaller side"
          }
        ]
      }
    ]
  }
