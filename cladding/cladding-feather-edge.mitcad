{
  "format": "mitcad",
  "version": 2,
  "units": {
    "length": "mm",
    "angle": "deg"
  },
  "parameters": [
    {
      "name": "W",
      "expression": "150 mm",
      "unit": "mm",
      "value": 150.0,
      "comment": ""
    },
    {
      "name": "T",
      "expression": "22 mm",
      "unit": "mm",
      "value": 22.0,
      "comment": ""
    },
    {
      "name": "L",
      "expression": "3000 mm",
      "unit": "mm",
      "value": 3000.0,
      "comment": ""
    },
    {
      "name": "TN",
      "expression": "6 mm",
      "unit": "mm",
      "value": 6.0,
      "comment": ""
    },
    {
      "name": "O",
      "expression": "30 mm",
      "unit": "mm",
      "value": 30.0,
      "comment": ""
    },
    {
      "name": "FA",
      "expression": "atan2(T - (T - TN) * (W - O) / W, W - O)",
      "unit": "deg",
      "value": 0.07651698431633913,
      "comment": ""
    },
    {
      "name": "COV",
      "expression": "sqrt((W - O) * (W - O) + (T - (T - TN) * (W - O) / W) * (T - (T - TN) * (W - O) / W))",
      "unit": "mm",
      "value": 120.35214996002357,
      "comment": ""
    },
    {
      "name": "HX",
      "expression": "(W * cos(FA) + TN * sin(FA)) / 2",
      "unit": "mm",
      "value": 75.00987728926012,
      "comment": ""
    },
    {
      "name": "HY",
      "expression": "(T * cos(FA) + W * sin(FA)) / 2",
      "unit": "mm",
      "value": 16.700989559950912,
      "comment": ""
    },
    {
      "name": "YC",
      "expression": "(T * cos(FA) - W * sin(FA)) / 2",
      "unit": "mm",
      "value": 5.234638518790584,
      "comment": ""
    },
    {
      "name": "d1",
      "expression": "-HX",
      "unit": "mm",
      "value": -75.00987728926012,
      "comment": "Section horizontal_distance",
      "owner": "F1"
    },
    {
      "name": "d2",
      "expression": "-YC",
      "unit": "mm",
      "value": -5.234638518790584,
      "comment": "Section vertical_distance",
      "owner": "F1"
    },
    {
      "name": "d3",
      "expression": "W * cos(FA) - HX",
      "unit": "mm",
      "value": 74.5512232476137,
      "comment": "Section horizontal_distance",
      "owner": "F1"
    },
    {
      "name": "d4",
      "expression": "-W * sin(FA) - YC",
      "unit": "mm",
      "value": -16.700989559950912,
      "comment": "Section vertical_distance",
      "owner": "F1"
    },
    {
      "name": "d5",
      "expression": "W * cos(FA) + TN * sin(FA) - HX",
      "unit": "mm",
      "value": 75.00987728926012,
      "comment": "Section horizontal_distance",
      "owner": "F1"
    },
    {
      "name": "d6",
      "expression": "-W * sin(FA) + TN * cos(FA) - YC",
      "unit": "mm",
      "value": -10.718545538475958,
      "comment": "Section vertical_distance",
      "owner": "F1"
    },
    {
      "name": "d7",
      "expression": "T * sin(FA) - HX",
      "unit": "mm",
      "value": -73.32814580322326,
      "comment": "Section horizontal_distance",
      "owner": "F1"
    },
    {
      "name": "d8",
      "expression": "T * cos(FA) - YC",
      "unit": "mm",
      "value": 16.700989559950912,
      "comment": "Section vertical_distance",
      "owner": "F1"
    },
    {
      "name": "d9",
